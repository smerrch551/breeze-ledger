<?xml version="1.0" encoding="utf-8"?>
<!-- Branded native launch window. A solid windowBackground is captured by the
     UI harness as a blank dark frame before React Native paints; a layer-list
     with the centred launcher icon gives that first frame real content. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splashBackground" />
    <item
        android:width="200dp"
        android:height="200dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher" />
</layer-list>
